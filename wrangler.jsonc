// Cloudflare: la web es estática (HTML, CSS, JS e imágenes), no hay que compilar nada.
{
  "name": "tuestampasf",
  "compatibility_date": "2026-10-01",
  // Dirección pública: tuestampasf.llucaslebrand.workers.dev (sin enlaces de vista previa)
  "workers_dev": true,
  "preview_urls": false,
  // Solo para la visita diaria a Supabase; la web la sirve Cloudflare directamente
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  // Todos los días a las 9:17 (hora de Argentina = 12:17 UTC)
  "triggers": { "crons": ["17 12 * * *"] }
}
